# ==============================================================================
# AutoShorts Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify settings for your local development environment:
#   cp .env.example .env
#
# DO NOT commit your personal '.env' file to version control.
# ==============================================================================

# Directory paths (leave blank for automatic platform detection)
ENGINE_DIR=./engine
OUTPUT_DIR=

# Optional: Cloud AI Integration (reserved for cloud transcription/APIs)
AI_API_KEY=<YOUR_API_KEY>
AI_API_ENDPOINT=https://api.example.com/v1

# Processing Configuration
FFMPEG_LOG_LEVEL=warning
MAX_CONCURRENT_WORKERS=2
